.cta-btn:hover{opacity:0.92}
.cta-note{font-size:11px;color:rgba(255,255,255,0.45);margin-top:10px}

</style>

<script>
const faqAnswers = [
  `La differenza non è nelle fonti — è nel <b>metodo e nel tempo</b>. Cercare bene richiede sapere dove guardare, come incrociare le informazioni e cosa scartare. L'AI processa in minuti quello che a te richiederebbe ore. Io poi filtro, verifico e trasformo tutto in qualcosa che puoi usare subito.`,
  `Entrambe le cose — in modo preciso. <b>L'AI fa la ricerca e la sintesi</b>, che sono le parti più lente e meccaniche. <b>Io faccio il brief, la revisione e il check finale</b> — che sono le parti che richiedono giudizio. Nessun report parte senza che io l'abbia letto e verificato.`,
  `Sì — anzi, le ricerche più specifiche sono spesso le più utili. Se hai un dubbio su un mercato di nicchia, un competitor poco noto o una normativa settoriale, <b>scrivimi comunque</b>. Se non riesco a fare la ricerca ti dico subito perché, senza farti perdere tempo.`,
  `Non lo so ancora con precisione — dipende da quello che imparerò in questa fase. Quello che posso dirti è che <b>chi partecipa alla beta avrà condizioni migliori</b> di chi arriverà dopo. E che non aumenterò i prezzi senza avvisare in anticipo.`,
  `Dipende dalla complessità della ricerca. <b>Ti dico i tempi precisi dopo la call</b>, quando ho capito cosa ti serve davvero. Non prometto tempi fissi per non darti un report fatto di fretta.`,
];

function selectFaq(el: HTMLElement, idx: number) {
  document.querySelectorAll('.faq-q-item').forEach(i => i.classList.remove('active'));
  el.classList.add('active');
  const panel = document.querySelector('.faq-answer-panel')!;
  panel.innerHTML = '<p>' + faqAnswers[idx] + '</p>';
}

const S = [
  {q:"Bandi PNRR per imprese edili in Liguria — scadenze nei prossimi mesi",steps:["raccolta fonti...","filtraggio bandi...","analisi requisiti...","generazione report..."],src:["ted.europa.eu","regione.liguria","mit.gov.it","simog.anac"],rt:"23 bandi rilevanti trovati",rb:"7 con scadenza imminente · importo medio 280k€ · requisiti sintetizzati"},
  {q:"Competitor palestra boutique Milano — prezzi e posizionamento",steps:["scansione web...","estrazione prezzi...","analisi positioning...","benchmark report..."],src:["google maps","tripadvisor","instagram pub.","siti aziendali"],rt:"31 competitor mappati",rb:"Fascia premium 120–180€/mese · 4 gap di posizionamento identificati"},
  {q:"Normative affitti brevi aggiornate — Toscana e Lombardia",steps:["monitoraggio normative...","confronto regionale...","alert scadenze...","digest finale..."],src:["gazzetta ufficiale","regione.toscana","regione.lombardia","mit.gov.it"],rt:"Report normativo pronto",rb:"3 nuovi obblighi in arrivo · 2 scadenze prossime · checklist allegata"}
];

let cur = 0;
const d = (ms: number) => new Promise(r => setTimeout(r, ms));

async function run(s: typeof S[0]) {
  const q = document.getElementById('qtxt')!;
  const st = document.getElementById('stxt')!;
  const pb = document.getElementById('pbar')! as HTMLElement;
  const pp = document.getElementById('ppct')!;
  const ps = document.getElementById('pstep')!;
  const sr = document.getElementById('srcs')!;
  const re = document.getElementById('res')!;
  const rt = document.getElementById('rtitle')!;
  const rb = document.getElementById('rbody')!;

  re.classList.remove('show');
  sr.innerHTML = '';
  pb.style.width = '0%';
  pp.textContent = '0%';
  st.textContent = 'analisi in corso';
  q.textContent = s.q;

  for (let i = 0; i < s.src.length; i++) {
    const c = document.createElement('span');
    c.className = 'chip';
    c.textContent = s.src[i];
    sr.appendChild(c);
    await d(90);
    c.classList.add('on');
  }
  await d(220);

  for (let i = 0; i < s.steps.length; i++) {
    ps.textContent = s.steps[i];
    const t = Math.round((i + 1) / s.steps.length * 100);
    const f = Math.round(i / s.steps.length * 100);
    for (let p = f; p <= t; p++) {
      pb.style.width = p + '%';
      pp.textContent = p + '%';
      await d(15);
    }
    if (sr.children[i]) sr.children[i].classList.add('done');
    await d(220);
  }

  st.textContent = 'completato';
  ps.textContent = 'report generato';
  rt.innerHTML = s.rt + '<span class="result-badge">✓ completato</span>';
  rb.textContent = s.rb;
  re.classList.add('show');
}

async function loop() {
  while (true) {
    await d(500);
    await run(S[cur]);
    cur = (cur + 1) % S.length;
    await d(2800);
  }
}

loop();
</script>

<script>
// Scroll + hero entrance animations
(function () {
  function mark(el: Element, delay = 0) {
    el.classList.add('will-anim');
    if (delay) (el as HTMLElement).style.setProperty('--ad', delay + 'ms');
  }

  // Hero: staggered on load
  const heroSeq: (Element | null)[] = [
    document.querySelector('.hero-tag'),
    document.querySelector('.hero h1'),
    document.querySelector('.hero-sub-line'),
    document.querySelector('.jack-box'),
    document.querySelector('.hero-btns'),
  ];
  const heroRight = document.querySelector('.hero-right');
  heroSeq.forEach((el, i) => {
    if (!el) return;
    mark(el);
    setTimeout(() => el.classList.add('in'), 50 + i * 85);
  });
  if (heroRight) {
    mark(heroRight);
    setTimeout(() => heroRight.classList.add('in'), 180);
  }

  // Scroll groups: stagger children within each container
  const groups: [string, string, number][] = [
    ['.perchi-grid',    '.perchi-item', 80],
    ['.svc-grid-v',     '.svc-card-l', 60],
    ['.steps-timeline', '.step-tl',    80],
    ['.rpt-grid',       '.rpt-card',   70],
    ['.metodo-steps',   '.ms',         55],
    ['.risultato-points','.rp-item',   70],
  ];
  groups.forEach(([parent, child, gap]) => {
    document.querySelectorAll(parent).forEach(p =>
      p.querySelectorAll(child).forEach((el, i) => mark(el, i * gap))
    );
  });

  // Individual elements (no stagger)
  ['.stats', '.sec-hd', '.honest', '.any-request', '.deliverable', '.rpt-intro', '.risultato-intro', '.risultato-sub', '.doc-stack', '.risultato-cta'].forEach(sel =>
    document.querySelectorAll(sel).forEach(el => mark(el))
  );

  // Observe scroll elements
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    });
  }, { threshold: 0.08, rootMargin: '0px 0px -30px 0px' });

  document.querySelectorAll('.will-anim:not(.in)').forEach(el => io.observe(el));
})();
</script>
