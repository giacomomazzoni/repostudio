     AI ANIMATION SCRIPT
═══════════════════════════════════════════ -->
<script>
const scenarios = [
  {
    query: 'Bandi PNRR disponibili per PMI in Liguria',
    sources: ['MISE.gov.it', 'RegioneLiguria.it', 'EU-Funds.eu', 'Camera.it'],
    result: 'Trovati 7 bandi attivi: Fondo Impresa Donna (scad. 30 nov), Transizione 5.0 (apertura permanente), Smart&Start aggiornato.',
  },
  {
    query: 'Analisi competitor palestre zona Navigli Milano',
    sources: ['Google Maps API', 'Trustpilot.it', 'Gympass.com', 'LinkedIn'],
    result: '12 competitor mappati. Prezzo medio: 49€/mese. Gap identificato: nessuno offre classi domenicali mattina.',
  },
  {
    query: 'Normativa affitti brevi 2026 — aggiornamenti',
    sources: ['GazzettaUfficiale.it', 'Agenzia.Entrate.it', 'Senato.it', 'Idealista.it'],
    result: 'D.L. 145/2025 in vigore: CIN obbligatorio, aliquota cedolare 26% >1 unità. Adempimento entro 31 dic 2026.',
  },
];

let current = 0;

async function sleep(ms: number): Promise<void> {
  return new Promise(r => setTimeout(r, ms));
}

async function runScenario(s: typeof scenarios[0]) {
  const qEl = document.getElementById('aiQuery')!;
  const pEl = document.getElementById('aiProgress')! as HTMLElement;
  const srcEl = document.getElementById('aiSources')!;
  const resEl = document.getElementById('aiResult')!;

  // Reset
  resEl.classList.remove('visible');
  resEl.textContent = '';
  srcEl.innerHTML = '';
  (pEl as HTMLElement).style.width = '0%';

  // Type query
  qEl.textContent = '';
  for (const ch of s.query) {
    qEl.textContent += ch;
    await sleep(30);
  }

  await sleep(400);

  // Progress bar + chips
  const step = 100 / (s.sources.length + 1);
  for (let i = 0; i < s.sources.length; i++) {
    await sleep(500);
    (pEl as HTMLElement).style.width = `${step * (i + 1)}%`;
    const chip = document.createElement('span');
    chip.className = 'ai-chip';
    chip.textContent = s.sources[i];
    srcEl.appendChild(chip);
  }

  await sleep(600);
  (pEl as HTMLElement).style.width = '100%';

  await sleep(400);
  resEl.textContent = s.result;
  resEl.classList.add('visible');

  await sleep(3500);
}

async function loop() {
  while (true) {
    await runScenario(scenarios[current]);
    current = (current + 1) % scenarios.length;
  }
}

loop();
</script>
