/* HONEST */
.honest{border:0.5px solid var(--acc-border);border-radius:12px;padding:36px;background:var(--acc-bg);max-width:720px;margin:0 auto}
.honest-tag{font-size:11px;font-weight:500;color:var(--acc);margin-bottom:12px}
.honest h2{font-size:22px;font-weight:500;letter-spacing:-0.5px;margin-bottom:14px;line-height:1.25}
