---
import Base from '../../layouts/Base.astro';
import { FORM_URL } from '../../config';

const allReports = await Astro.glob('./*.md');

const reports = allReports
  .filter((r) => r.frontmatter.published !== false)
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());
---

<Base
  title="Report — RepoStudio"
  description="Brief settimanali su mercati, normative, bandi e trend locali. Fonti verificate, sintesi chiara, subito utilizzabile."
  canonical="https://repostudio.it/report/"
>

<div class="rp-wrap">

  <div class="rp-header">
    <div class="sec-hd">report pubblicati</div>
    <h1>Ricerche già pronte.</h1>
    <p class="rp-sub">Ogni brief è prodotto con lo stesso metodo delle ricerche su misura — fonti verificate, sintesi chiara, subito utilizzabile.</p>
  </div>

  {reports.length === 0 ? (
    <p class="rp-empty">Nessun report ancora pubblicato. Torna presto.</p>
  ) : (
    <div class="rp-grid">
      {reports.map((r) => {
        const { title, description, date, category, zona, slug } = r.frontmatter;
        const dateFormatted = new Date(date).toLocaleDateString('it-IT', {
          day: 'numeric',
          month: 'long',
          year: 'numeric',
        });
        return (
          <a href={`/report/${slug}/`} class="rp-card">
            <div class="rp-card-top">
              <span class="rp-cat">{category}</span>
              <span class="rp-date">{dateFormatted}</span>
            </div>
            <h2>{title}</h2>
            <p>{description}</p>
            <div class="rp-card-foot">
              <span class="rp-zona">{zona}</span>
              <span class="rp-arr">→</span>
            </div>
          </a>
        );
      })}
    </div>
  )}

  <a class="any-request" href={FORM_URL} target="_blank" rel="noopener">
    <span class="any-icon">
      <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    </span>
    <div class="any-text"><b>Non trovi la ricerca che ti serve?</b>Richiedila su misura — probabilmente la faccio.</div>
    <span class="any-arr-right">→</span>
  </a>

</div>

</Base>

<style>
.rp-wrap{padding:48px 0 72px}

.rp-header{margin-bottom:40px;max-width:560px}
.rp-header h1{font-size:clamp(28px,4vw,40px);font-weight:500;letter-spacing:-1.5px;line-height:1.05;margin-bottom:12px;margin-top:20px}
.rp-sub{font-size:14px;color:var(--ink2);line-height:1.65}

.rp-empty{text-align:center;padding:60px 0;font-size:14px;color:var(--ink3)}

.rp-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:10px}
@media(max-width:640px){.rp-grid{grid-template-columns:1fr}}

.rp-card{border:0.5px solid var(--line);border-radius:10px;padding:20px;display:flex;flex-direction:column;gap:8px;text-decoration:none;transition:border-color 0.15s,box-shadow 0.15s,transform 0.15s}
.rp-card:hover{border-color:var(--acc-border);box-shadow:0 4px 16px rgba(108,99,255,0.08);transform:translateY(-1px)}

.rp-card-top{display:flex;align-items:center;justify-content:space-between;gap:10px}
.rp-cat{font-size:10px;font-weight:500;color:var(--acc);background:var(--acc-bg);border:0.5px solid var(--acc-border);padding:2px 8px;border-radius:3px}
.rp-date{font-size:11px;color:var(--ink3)}

.rp-card h2{font-size:15px;font-weight:500;letter-spacing:-0.3px;line-height:1.3;color:var(--ink)}
.rp-card p{font-size:12px;line-height:1.6;color:var(--ink2);flex:1}

.rp-card-foot{display:flex;align-items:center;justify-content:space-between;margin-top:4px}
.rp-zona{font-size:11px;color:var(--ink3)}
.rp-arr{color:var(--acc);font-size:14px}

/* reuse from index.astro */
.any-request{display:flex;align-items:center;gap:12px;padding:14px 18px;border:0.5px solid var(--line);border-radius:10px;background:var(--surf);text-decoration:none;color:inherit;transition:border-color 0.1s}
.any-request:hover{border-color:var(--acc)}
.any-icon{color:var(--acc);flex-shrink:0}
.any-icon svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
.any-text{font-size:13px;color:var(--ink2);line-height:1.5}
.any-text b{color:var(--ink);font-weight:500;display:block;margin-bottom:1px}
.any-arr-right{font-size:14px;color:var(--ink3);margin-left:auto}
</style>
