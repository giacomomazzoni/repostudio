---
import '../styles/global.css';
import { FORM_URL, SLOTS } from '../config';

const {
  title = 'RepoStudio — Ricerche di mercato con AI',
  description = "Smetti di perdere ore a cercare informazioni. Te le trovo io, con l'AI. Report professionale, pronto da usare.",
  canonical = 'https://repostudio.it',
  ogType = 'website',
  showStickyCta = false,
} = Astro.props;

const faviconSvg = `<svg width="64" height="64" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg"><rect x="10" y="42" width="12" height="16" rx="6" fill="#6C63FF" opacity="0.4"/><rect x="26" y="30" width="12" height="28" rx="6" fill="#6C63FF" opacity="0.7"/><rect x="42" y="18" width="12" height="40" rx="6" fill="#6C63FF"/></svg>`;
const faviconDataUri = `data:image/svg+xml;base64,${Buffer.from(faviconSvg).toString('base64')}`;
---

<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="RepoStudio" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="icon" type="image/svg+xml" href={faviconDataUri} />
</head>
<body>

<div class="top-banner">
  <span class="top-banner-dot"></span>
  Beta aperta —&nbsp;<span class="top-banner-num" id="banner-num">{SLOTS}</span>&nbsp;posti disponibili questa settimana
  <a href={FORM_URL}>Richiedi gratis →</a>
</div>

<div class="page">

<nav class="nav">
  <a class="logo" href="/">
    <svg width="30" height="30" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0">
      <rect x="10" y="42" width="12" height="16" rx="6" fill="#6C63FF" opacity="0.4"/>
      <rect x="26" y="30" width="12" height="28" rx="6" fill="#6C63FF" opacity="0.7"/>
      <rect x="42" y="18" width="12" height="40" rx="6" fill="#6C63FF"/>
    </svg>
    <span style="display:flex;flex-direction:column;gap:1px">
      <span style="font-size:14px;font-weight:600;letter-spacing:-0.4px;color:#0A0A12;line-height:1">RepoStudio</span>
      <span style="font-size:8px;font-weight:500;letter-spacing:2px;color:#6C63FF;line-height:1">AI-POWERED RESEARCH</span>
    </span>
    <span class="logo-badge">BETA</span>
  </a>
  <div class="nav-links" id="nav-links">
    <a class="nav-link" href="/#servizi">Servizi</a>
    <a class="nav-link" href="/#metodo">Metodo</a>
    <a class="nav-link" href="/report/">Report</a>
    <a class="nav-link" href="/#faq">FAQ</a>
  </div>
  <a class="nav-cta" href={FORM_URL}>Richiedi gratis →</a>
  <button class="nav-burger" id="nav-burger" aria-label="Menu" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
</nav>

<!-- MOBILE MENU DRAWER -->
<div class="nav-drawer" id="nav-drawer">
  <a class="nav-link" href="/#servizi" onclick="closeDrawer()">Servizi</a>
  <a class="nav-link" href="/#metodo" onclick="closeDrawer()">Metodo</a>
  <a class="nav-link" href="/report/" onclick="closeDrawer()">Report</a>
  <a class="nav-link" href="/#faq" onclick="closeDrawer()">FAQ</a>
  <a class="nav-cta drawer-cta" href={FORM_URL}>Richiedi gratis →</a>
</div>

<slot />

<footer class="foot">
  <div class="foot-left">
    <span class="foot-brand">RepoStudio</span>
    <span class="foot-sep">·</span>
    <a class="foot-link" href="/report/">Report</a>
    <span class="foot-sep">·</span>
    <a class="foot-link" href={FORM_URL} target="_blank" rel="noopener">Richiedi ricerca</a>
  </div>
  <div class="foot-right">
    <span>by Jack Mazzoni · Genova · 2026</span>
  </div>
</footer>

</div>

{showStickyCta && (
  <div class="sticky-cta" id="sticky-cta">
    <a class="sticky-cta-btn" href={FORM_URL}>Fai la tua prima ricerca gratis →</a>
    <div class="sticky-cta-note">Gratis · nessuna carta di credito</div>
  </div>
)}

</body>
</html>

<style>
/* STICKY CTA */
.sticky-cta{display:none;position:fixed;bottom:0;left:0;right:0;z-index:200;padding:12px 16px 28px;background:#fff;border-top:0.5px solid var(--line);box-shadow:0 -8px 24px rgba(0,0,0,0.08)}
.sticky-cta-btn{width:100%;background:var(--acc);color:#fff;border:none;padding:15px;border-radius:10px;font-size:15px;font-weight:500;cursor:pointer;text-decoration:none;display:block;text-align:center}
.sticky-cta-note{font-size:11px;color:var(--ink3);text-align:center;margin-top:6px}
@media(max-width:640px){.sticky-cta{display:block}}

/* HAMBURGER */
.nav-burger{display:none;flex-direction:column;gap:4px;background:none;border:none;cursor:pointer;padding:4px;flex-shrink:0}
.nav-burger span{display:block;width:20px;height:1.5px;background:var(--ink);border-radius:2px;transition:transform 0.2s,opacity 0.2s}
.nav-burger.open span:nth-child(1){transform:translateY(5.5px) rotate(45deg)}
.nav-burger.open span:nth-child(2){opacity:0}
.nav-burger.open span:nth-child(3){transform:translateY(-5.5px) rotate(-45deg)}
@media(max-width:640px){.nav-burger{display:flex}}

/* MOBILE DRAWER */
.nav-drawer{display:none;flex-direction:column;gap:0;background:#fff;border-bottom:0.5px solid var(--line);padding:8px 20px 16px}
.nav-drawer.open{display:flex}
.nav-drawer .nav-link{font-size:15px;padding:12px 0;border-bottom:0.5px solid var(--line);color:var(--ink2);text-decoration:none}
.nav-drawer .nav-link:last-of-type{border-bottom:none}
.drawer-cta{margin-top:14px;background:var(--acc);color:#fff;text-align:center;padding:13px;border-radius:9px;font-size:14px;font-weight:500;text-decoration:none}

/* FOOTER */
.foot{padding:24px 0;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;border-top:0.5px solid var(--line)}
.foot-left{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.foot-brand{font-size:12px;font-weight:500;color:var(--ink)}
.foot-sep{font-size:12px;color:var(--ink3)}
.foot-link{font-size:12px;color:var(--ink3);text-decoration:none;transition:color 0.15s}
.foot-link:hover{color:var(--acc)}
.foot-right{font-size:11px;color:var(--ink3)}
@media(max-width:640px){.foot{padding-bottom:80px;flex-direction:column;align-items:flex-start;gap:8px}}
</style>

<script>
const heroCta = document.querySelector('.btn-a') as HTMLElement | null;
const stickyCta = document.getElementById('sticky-cta');
if (heroCta && stickyCta) {
  const obs = new IntersectionObserver(
    ([entry]) => { stickyCta.style.display = entry.isIntersecting ? 'none' : ''; },
    { threshold: 0 }
  );
  obs.observe(heroCta);
}

const burger = document.getElementById('nav-burger');
const drawer = document.getElementById('nav-drawer');
function closeDrawer() {
  burger?.classList.remove('open');
  drawer?.classList.remove('open');
  burger?.setAttribute('aria-expanded', 'false');
}
burger?.addEventListener('click', () => {
  const isOpen = drawer?.classList.contains('open');
  if (isOpen) {
    closeDrawer();
  } else {
    burger?.classList.add('open');
    drawer?.classList.add('open');
    burger?.setAttribute('aria-expanded', 'true');
  }
});
(window as any).closeDrawer = closeDrawer;
</script>
