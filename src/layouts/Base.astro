---
import '../styles/global.css';

const FORM_URL = 'YOUR_FORM_LINK_HERE';
const SLOTS = 4;

const {
  title = 'RepoStudio — Ricerche AI per PMI e professionisti',
  description = 'Dimmi cosa devi sapere. Ricevi un report professionale, pronto da usare. Gratis in beta.',
  canonical = 'https://repostudio.it',
  ogType = 'website',
} = Astro.props;

const faviconSvg = `<svg width="64" height="64" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg"><rect x="10" y="42" width="12" height="16" rx="6" fill="#6C63FF" opacity="0.4"/><rect x="26" y="30" width="12" height="28" rx="6" fill="#6C63FF" opacity="0.7"/><rect x="42" y="18" width="12" height="40" rx="6" fill="#6C63FF"/></svg>`;
const faviconDataUri = `data:image/svg+xml;base64,${Buffer.from(faviconSvg).toString('base64')}`;
---

<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="RepoStudio" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <link rel="icon" type="image/svg+xml" href={faviconDataUri} />

</head>
<body>

<!-- TOP BANNER -->
<div class="top-banner">
  <span class="dot-green"></span>
  <span>Beta aperta — <strong>{SLOTS} posti disponibili</strong> questa settimana</span>
  <a href={FORM_URL} target="_blank" rel="noopener">Richiedi gratis →</a>
</div>

<!-- NAV -->
<header class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <!-- Logo: 3 barre viola -->
      <svg width="28" height="28" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="10" y="42" width="12" height="16" rx="6" fill="#6C63FF" opacity="0.4"/>
        <rect x="26" y="30" width="12" height="28" rx="6" fill="#6C63FF" opacity="0.7"/>
        <rect x="42" y="18" width="12" height="40" rx="6" fill="#6C63FF"/>
      </svg>
      <div class="nav-wordmark">
        <strong>RepoStudio</strong>
        <span>AI-POWERED RESEARCH</span>
      </div>
      <span class="nav-badge">BETA</span>
    </a>

    <nav aria-label="Navigazione principale">
      <ul class="nav-links">
        <li><a href="/#servizi">Servizi</a></li>
        <li><a href="/#metodo">Metodo</a></li>
        <li><a href="/report/">Report</a></li>
        <li><a href="/#faq">FAQ</a></li>
      </ul>
    </nav>

    <a href={FORM_URL} class="btn btn-primary nav-cta" target="_blank" rel="noopener">
      Richiedi gratis →
    </a>
  </div>
</header>

<!-- MAIN CONTENT -->
<main>
  <slot />
</main>

<!-- FOOTER -->
<footer class="footer-wrap">
  <div class="footer">
    <p>RepoStudio · Genova · 2026</p>
    <p>by Jack Mazzoni</p>
  </div>
</footer>

</body>
</html>
